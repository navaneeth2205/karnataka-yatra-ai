# Karnataka Yatra AI - Backend Environment Variables
APP_NAME="Karnataka Yatra AI"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Optional LLM integration (defaults to deterministic rule-based planner if unset)
GEMINI_API_KEY=""
